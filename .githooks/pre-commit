#!/usr/bin/env bash
set -euo pipefail

# Pre-commit gate: the two repository checks that are cheap enough to run on
# every commit. Both are read-only.
#   - validate-changelog.sh: only when CHANGELOG.md is staged, so an
#     unreleased work-in-progress commit is not blocked by entry format rules.
#   - verify_codebase_sync.sh: every commit, because both a stale path in
#     CODEBASE.md and an undocumented file stay invisible until someone
#     follows the document or hunts for the file.
#
# Scripts are invoked through bash so a checkout that lost the executable bit
# still runs them.

if git diff --cached --name-only | grep -qx 'CHANGELOG.md'; then
  echo "Validating newest CHANGELOG.md entry"
  bash ./scripts/validate-changelog.sh
fi

echo "Checking CODEBASE.md against the repository (both directions)"
bash ./scripts/verify_codebase_sync.sh
